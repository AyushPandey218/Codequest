{
  "rewrites": [
    {
      "source": "/wandbox/:path*",
      "destination": "https://online.wandbox.org/:path*"
    },
    {
      "source": "/piston/:path*",
      "destination": "https://emkc.org/:path*"
    },
    {
      "source": "/jdoodle/:path*",
      "destination": "https://api.jdoodle.com/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
